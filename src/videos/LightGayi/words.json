  "lines": [
    {
      "text": "Exam se ek raat pehle, light gayi, aur admit card band locker mein hai!",
      "start": 0.06,
      "end": 3.86,
      "startFrame": 2,
      "endFrame": 116
    },
    {
      "text": "Riya ke paas ek power bank hai, jo sirf ek cheez charge kar sakta hai.",
      "start": 4.05,
      "end": 7.34,
      "startFrame": 122,
      "endFrame": 220
    },
    {
      "text": "Phone mein sattar percent battery hai.",
      "start": 7.56,
      "end": 9.24,
      "startFrame": 227,
      "endFrame": 277
    },
    {
      "text": "Torch zero, aur fingerprint locker bhi zero.",
      "start": 9.24,
      "end": 11.535,
      "startFrame": 277,
      "endFrame": 346
    },
    {
      "text": "Bahar ghup andhera, aur bus subah chhe baje.",
      "start": 11.7,
      "end": 13.995,
      "startFrame": 351,
      "endFrame": 420
    },
    {
      "text": "Galat choice ki, toh exam gaya! Riya pehle kya charge kare?",
      "start": 14.13,
      "end": 17.535,
      "startFrame": 424,
      "endFrame": 526
    },
    {
      "text": "A, phone. B, torch. C, fingerprint locker. D, teeno thoda thoda.",
      "start": 17.64,
      "end": 22.155,
      "startFrame": 529,
      "endFrame": 665
    },
    {
      "text": "Sabse pehle sahi jawab dene wale ko sau rupaye cash prize, jaldi comment karo!",
      "start": 22.35,
      "end": 26.445,
      "startFrame": 670,
      "endFrame": 793
    },
    {
      "text": "Answer in the next reel, follow karo @rehanfact!",
      "start": 26.58,
      "end": 29.235,
      "startFrame": 797,
      "endFrame": 877
    }
  ],
