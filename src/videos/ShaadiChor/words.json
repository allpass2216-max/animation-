  "lines": [
    {
      "text": "Shaadi ki raat, dulhan ka haar gayab, chor isi kamre mein hai!",
      "start": 1.26,
      "end": 3.72,
      "startFrame": 38,
      "endFrame": 112
    },
    {
      "text": "Inspector Rana ne chaaron ko line mein khada kiya.",
      "start": 3.72,
      "end": 6.315,
      "startFrame": 112,
      "endFrame": 189
    },
    {
      "text": "Halwai Ramesh bola, main poori raat kitchen mein tha.",
      "start": 6.42,
      "end": 8.835,
      "startFrame": 193,
      "endFrame": 265
    },
    {
      "text": "Cousin Neha boli, main mehendi lagwa rahi thi.",
      "start": 9.12,
      "end": 11.085,
      "startFrame": 274,
      "endFrame": 333
    },
    {
      "text": "Photographer Vicky bola, mera daayan haath toota hai, main kaise churaunga?",
      "start": 11.19,
      "end": 14.505,
      "startFrame": 336,
      "endFrame": 435
    },
    {
      "text": "Kamla bai boli, main toh chhat par thi.",
      "start": 14.7,
      "end": 16.44,
      "startFrame": 441,
      "endFrame": 493
    },
    {
      "text": "Tabhi inspector muskuraya, dhyan se dekho, ek ne khud ko pakadwa diya!",
      "start": 16.44,
      "end": 20.98,
      "startFrame": 493,
      "endFrame": 629
    },
    {
      "text": "A, Ramesh. B, Neha. C, Vicky. D, Kamla bai.",
      "start": 20.98,
      "end": 24.615,
      "startFrame": 629,
      "endFrame": 738
    },
    {
      "text": "Sahi jawab batane wale ko sau rupaye cash prize, comment mein likho, dost ko share karke help lo!",
      "start": 24.9,
      "end": 29.775,
      "startFrame": 747,
      "endFrame": 893
    },
    {
      "text": "Winner ko paisa part two mein, answer in the next reel, follow karo @rehanfact!",
      "start": 30.15,
      "end": 34.335,
      "startFrame": 904,
      "endFrame": 1030
    }
  ],
