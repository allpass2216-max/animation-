  "note": "whisper failed: URLError: <urlopen error Tunnel connection failed: 403 Forbidden>",
  "lines": [
    {
      "text": "Raat das baje, Raju ek sau bees feet oonchi tanki par phans gaya!",
      "start": 0.12,
      "end": 3.795,
      "startFrame": 4,
      "endFrame": 114
    },
    {
      "text": "Seedhi toot gayi, subah tak koi nahi aayega.",
      "start": 4.17,
      "end": 6.585,
      "startFrame": 125,
      "endFrame": 198
    },
    {
      "text": "Paas mein nabbe feet rassi, aur ek chaaku.",
      "start": 6.78,
      "end": 9.135,
      "startFrame": 203,
      "endFrame": 274
    },
    {
      "text": "Upar ek kunda, aur saath feet neeche chhajje par doosra.",
      "start": 9.42,
      "end": 12.375,
      "startFrame": 283,
      "endFrame": 371
    },
    {
      "text": "Poori rassi upar baandhi, toh tees feet hawa mein latkega, zinda neeche kaise utrega?",
      "start": 12.6,
      "end": 16.875,
      "startFrame": 378,
      "endFrame": 506
    },
    {
      "text": "A, tees feet ka loop upar, saath feet rassi double karke chhajje tak, phir kheench ke neeche.",
      "start": 17.1,
      "end": 21.975,
      "startFrame": 513,
      "endFrame": 659
    },
    {
      "text": "B, poori rassi upar baandho, aur aakhri tees feet kood jao.",
      "start": 22.23,
      "end": 25.58,
      "startFrame": 667,
      "endFrame": 767
    },
    {
      "text": "C, chhajje tak utro, phir upar wali gaanth khol do.",
      "start": 25.86,
      "end": 28.58,
      "startFrame": 776,
      "endFrame": 857
    },
    {
      "text": "D, chaaku se rassi kaat ke, lambi kar lo.",
      "start": 28.86,
      "end": 31.155,
      "startFrame": 866,
      "endFrame": 935
    },
    {
      "text": "Comment karo, answer in the next reel, follow karo @rehanfact!",
      "start": 31.32,
      "end": 34.935,
      "startFrame": 940,
      "endFrame": 1048
    }
  ],
