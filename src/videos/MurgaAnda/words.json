  "lines": [
    {
      "text": "Sonu aur Monu padosi hain.",
      "start": 0.12,
      "end": 1.58,
      "startFrame": 4,
      "endFrame": 47
    },
    {
      "text": "Dono gharon ke beech, ek chhoti si deewar hai.",
      "start": 1.86,
      "end": 4.245,
      "startFrame": 56,
      "endFrame": 127
    },
    {
      "text": "Ek subah, Sonu ka laal murga deewar par chadha, aur wahin ek anda de diya.",
      "start": 4.38,
      "end": 8.385,
      "startFrame": 131,
      "endFrame": 252
    },
    {
      "text": "Anda Monu ki taraf gira, aur dono lad pade, anda kiska?",
      "start": 8.4,
      "end": 11.69,
      "startFrame": 252,
      "endFrame": 351
    },
    {
      "text": "Poora mohalla jama ho gaya, ab faisla tumhare haath mein hai!",
      "start": 12.13,
      "end": 15.08,
      "startFrame": 364,
      "endFrame": 452
    },
    {
      "text": "A, Sonu ka, kyunki murga uska hai. B, Monu ka, kyunki anda uski taraf gira.",
      "start": 15.09,
      "end": 20.115,
      "startFrame": 453,
      "endFrame": 603
    },
    {
      "text": "C, aadha aadha baant lo. D, kisi ka nahi.",
      "start": 20.31,
      "end": 22.995,
      "startFrame": 609,
      "endFrame": 690
    },
    {
      "text": "Dhyan se socho, comment karo, answer in the next reel, follow karo @rehanfact!",
      "start": 23.01,
      "end": 27.615,
      "startFrame": 690,
      "endFrame": 828
    }
  ],
