  "lines": [
    {
      "text": "Video editing app ke liye har mahine paise dena band karo!",
      "start": 0.12,
      "end": 3.075,
      "startFrame": 4,
      "endFrame": 92
    },
    {
      "text": "Kyunki ek free tool hai, naam hai Kdenlive, aur poora open source.",
      "start": 3.24,
      "end": 7.005,
      "startFrame": 97,
      "endFrame": 210
    },
    {
      "text": "Laptop par chalta hai, Windows, Mac, Linux, sab par.",
      "start": 7.32,
      "end": 10.34,
      "startFrame": 220,
      "endFrame": 310
    },
    {
      "text": "Multi track timeline, titles, transitions, effects, sab kuch.",
      "start": 10.47,
      "end": 13.88,
      "startFrame": 314,
      "endFrame": 416
    },
    {
      "text": "Aur sabse badhiya baat, koi watermark nahi, koi subscription nahi.",
      "start": 14.49,
      "end": 17.445,
      "startFrame": 435,
      "endFrame": 523
    },
    {
      "text": "Export karo MP4 mein, woh bhi four K tak.",
      "start": 17.88,
      "end": 20.535,
      "startFrame": 536,
      "endFrame": 616
    },
    {
      "text": "Sahil ne isi se poore hafte ki reels banayi, aur ek rupaya kharch nahi kiya.",
      "start": 20.88,
      "end": 24.705,
      "startFrame": 626,
      "endFrame": 741
    },
    {
      "text": "Toh is reel ko abhi save kar lo.",
      "start": 24.87,
      "end": 26.355,
      "startFrame": 746,
      "endFrame": 791
    },
    {
      "text": "Download link chahiye, toh comment mein likho EDIT, main bhej dunga.",
      "start": 26.55,
      "end": 29.535,
      "startFrame": 796,
      "endFrame": 886
    },
    {
      "text": "Aur follow karo @rehanfact, aise aur free tools ke liye!",
      "start": 29.55,
      "end": 32.865,
      "startFrame": 886,
      "endFrame": 986
    }
  ],
