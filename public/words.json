  "lines": [
    {
      "text": "Rohan aur Kunal, ek hi din naukri lage, dono ki salary tees hazaar.",
      "start": 0.15,
      "end": 3.975,
      "startFrame": 4,
      "endFrame": 119
    },
    {
      "text": "Rohan har mahine sab uda deta, naya phone, party, online shopping.",
      "start": 4.35,
      "end": 8.595,
      "startFrame": 130,
      "endFrame": 258
    },
    {
      "text": "Kunal har mahine sirf teen hazaar alag rakhta, SIP mein, baaki aaram se kharch.",
      "start": 8.79,
      "end": 13.665,
      "startFrame": 264,
      "endFrame": 410
    },
    {
      "text": "Dost hanse, teen hazaar se kya crorepati banega?",
      "start": 15.0,
      "end": 17.415,
      "startFrame": 450,
      "endFrame": 522
    },
    {
      "text": "Har saal baarah percent ka return, toh das saal baad, Kunal ke paas kitne honge?",
      "start": 17.64,
      "end": 21.855,
      "startFrame": 529,
      "endFrame": 656
    },
    {
      "text": "A, lagbhag saat lakh.",
      "start": 22.13,
      "end": 23.325,
      "startFrame": 664,
      "endFrame": 700
    },
    {
      "text": "B, sirf teen lakh saath hazaar.",
      "start": 23.7,
      "end": 25.785,
      "startFrame": 711,
      "endFrame": 774
    },
    {
      "text": "C, lagbhag gyaarah lakh.",
      "start": 25.95,
      "end": 27.405,
      "startFrame": 778,
      "endFrame": 822
    },
    {
      "text": "D, poore ek crore.",
      "start": 27.63,
      "end": 29.025,
      "startFrame": 829,
      "endFrame": 871
    },
    {
      "text": "Tum salary ki roti sab kha rahe ho, ya kuch beej bhi bo rahe ho? Comment karo, answer in the next reel, follow karo @rehanfact!",
      "start": 29.1,
      "end": 35.955,
      "startFrame": 873,
      "endFrame": 1079
    }
  ],
